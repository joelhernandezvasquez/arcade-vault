# Copiar este archivo a .env.local y completar con una API key real de Resend
# (https://resend.com/api-keys) para que el envío de correo del formulario de
# contacto en /acerca-de funcione. No commitear .env.local.
RESEND_API_KEY=

# URL y anon/publishable key del proyecto Supabase (Project Settings > API).
# Se usan para inicializar los clientes de lib/supabase/client.ts y server.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
